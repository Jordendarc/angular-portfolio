{
  "hosting": {
    "target": "portfolio",
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/aboutMe",
        "type": 302
      }
    ]
  }
}
