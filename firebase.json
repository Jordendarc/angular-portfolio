{
  "hosting": {
    "target": "portfolio",
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/aboutMe",
        "destination": "/en",
        "type": 301
      },
      {
        "source": "/work",
        "destination": "/en#experience",
        "type": 301
      }
    ]
  }
}
